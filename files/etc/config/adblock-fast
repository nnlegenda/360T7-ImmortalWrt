config adblock-fast 'config'
	option enabled '1'
	option dns 'dnsmasq.servers'
	list dnsmasq_instance '*'
	option force_dns '1'
	list force_dns_port '53'
	list force_dns_port '853'
	option curl_max_file_size '8000000'
	option curl_retry '3'
	option download_timeout '15'
	option download_connect_timeout '15'
	option parallel_downloads '8'
	option verbosity '1'
	option update_config_sizes '0'
	option compressed_cache '0'
	option sanity_check '1'
	option heartbeat_domain 'www.baidu.com'
	option heartbeat_sleep_timeout '10'

